}

// ───────── audit ─────────
Table audit.actions {
  id text [pk]
  at timestamptz
  operator text
  method text
  route text
  entity_ids text[] [note: 'любые id, без связи']
  summary jsonb
  label_id text
  Note: 'След оператора: каждая запись API (оператор, метод, маршрут, entity_ids, summary). Строк: 251. Личные данные в колонках: operator.'
}

