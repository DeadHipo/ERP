  source text
  decided_by text
  decided_at timestamptz
  songwriter_id text
  indexes {
    (song_id, isrc) [pk]
  }
  Note: 'Решение оператора: песня pubv2 -> ISRC. Строк: 18.'
}

Table links.publishing_terms {
  id text [pk]
  owner_id text
  percent numeric
  valid_from date
  valid_to date
  document_id text
