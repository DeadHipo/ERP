// ERP 0to8: ТЕКУЩАЯ схема всех таблиц на 2026-11-16 (ветка feature/fable-003, после D-216). Для https://dbdiagram.io/d
// Источники: packages/backend/src/modules/*/schema.ts, src/auth, src/orgs, migrations/postgres/0001..0032, migrations/clickhouse/0001..0003,
// живая база (information_schema.columns, pg_constraint, SELECT count(*)). Числа строк сняты 2026-11-16.
//
// ЛЕГЕНДА
//  * org_id NOT NULL есть в КАЖДОЙ таблице PostgreSQL (D-170) и указывает на orgs.organizations.id (FK нет); колонку и связь не рисуем.
//    Составные ключи с org_id: auth.memberships (user_id, org_id), auth.user_labels (user_id, org_id, label_id), labels.label_aliases (org_id, alias_norm), и т. п.
//  * Цвет связи (Ref ... [color: ...]):
//      серый    #888888  настоящий FOREIGN KEY в базе (pg_constraint); все только внутри одного модуля
//      синий    #1f77b4  id внутри модуля, FK нет (проверяет сервис модуля)
//      зелёный  #2ca02c  id между модулями, FK нет (держит фасад, D-121)
//      оранжевый #ff7f0e связь по ISRC (или UPC): общий ключ, мастер-справочника ISRC нет; цель рисуем в owners.tracks / owners.releases
//      красный  #d62728  связь по строке (имя, label_name, account, writer_norm, название): хрупкое место
//  * Группа TableGroup = модуль (схема PostgreSQL); owners разбит на две группы (люди+бумаги и каталог) для читаемости, это один модуль.
//  * В Note каждой таблицы: что это и число строк живой базы. Колонки с личными данными названы в Note таблицы, значения не приводятся.
//  * Колонки с JSON внутри текста (settlements.operations.allocation, payout_snapshots.payload) несут id внутри строки: рисуем только allocation (зелёная).
//  * Не рисуются как Ref: owners.releases.label_string (только показ, ни одного чтения связи), documents.file_ref (внешняя ссылка pandadoc:<sha256>),
//    settlements.payees.payee_ref (внешний реквизит), audit.actions.entity_ids (любые id), pub_lines.period / pubv2.accruals.period (месяц-ключ).

Project erp_0to8_current {
  database_type: 'PostgreSQL'
  Note: 'Текущая схема: 48 таблиц PostgreSQL (без schema_migrations) + ClickHouse believe.rows. Деньги пересчитываются из строк отчётов, начислений не хранится.'
}

// ───────── orgs_auth ─────────
Table orgs.organizations {
  id text [pk]
  name text
  created_at timestamptz
  created_by text
  Note: 'Организации (арендаторы); граница изоляции данных, на неё указывает org_id всех таблиц. Строк: 1.'
}

Table auth.users {
  id text [pk]
  login text
  password_hash text
  is_system_admin boolean
  created_at timestamptz
  created_by text
  disabled_at timestamptz
  Note: 'Пользователи (логин, хэш пароля, признак системного администратора). Строк: 2. Личные данные в колонках: login, password_hash.'
}

Table auth.memberships {
  user_id text [pk]
  role text
  created_at timestamptz
  created_by text
  disabled_at timestamptz
  indexes {
    (user_id) [pk]
  }
  Note: 'Членство пользователя в организации с ролью (org_admin / label_manager); PK (user_id, org_id). Строк: 1.'
}

Table auth.user_labels {
  user_id text
  label_id text
  created_at timestamptz
  created_by text
  indexes {
    (user_id, label_id) [pk]
  }
  Note: 'Лейблы, которые видит менеджер лейбла; PK (user_id, org_id, label_id). Строк: 0.'
}

Table auth.sessions {
  id text [pk]
  user_id text
  issued_at timestamptz
  expires_at timestamptz
  revoked_at timestamptz
  Note: 'Отзываемые сессии входа (токен несёт id строки). Строк: 1.'
}

Table auth.support_grants {
  id text [pk]
  user_id text
  write boolean
  granted_by text
  granted_at timestamptz
  expires_at timestamptz
  revoked_at timestamptz
  revoked_by text
  Note: 'Временные права поддержки: системный администратор в организации до 7 дней. Строк: 0.'
}

// ───────── labels ─────────
Table labels.labels {
  id text [pk]
  name text
  kind text
  own_label_id text
  created_at timestamptz
  Note: 'Лейблы: свои (own) и саблейблы (sublabel, own_label_id = чей). Строк: 17. Уникально (с org_id): (name).'
}

Table labels.label_aliases {
  alias_norm text [pk, note: 'нормализованная строка label_name Believe']
  alias text
  label_id text
  Note: 'Импринты: нормализованная строка label_name отчёта Believe -> лейбл (без периода). Строк: 34.'
}

Table labels.label_rules {
  id text [pk]
  label_id text
  percent numeric
  recipient_artist_id text
  valid_from date
  valid_to date
  document_id text
  "note" text
  created_at timestamptz
  Note: 'Правила саблейбла: процент и получатель-псевдоним на период, с документом. Строк: 16.'
}

Table labels.label_accounts {
  account text [pk, note: 'аккаунт Believe']
  label_id text
  created_at timestamptz
  Note: 'Аккаунт Believe -> своя книга (лейбл); граница книги (D-169). Строк: 2.'
}

// ───────── owners_people_papers ─────────
Table owners.owners {
  id text [pk]
  name text
  name_norm text
  kind text
  ipi text
  merged_into text
  created_at timestamptz
  origin text
  Note: 'Владельцы: получатели денег (person | label), с IPI и ссылкой слияния. Строк: 1 328. Личные данные в колонках: name, name_norm, ipi.'
}

Table owners.owner_aliases {
  owner_id text
  alias text
  alias_norm text
  indexes {
    (alias_norm, owner_id) [pk]
  }
  Note: 'Псевдонимы-имена владельца (в том числе юридические имена по реестру); ключ поиска автора B17. Строк: 1 327. Личные данные в колонках: alias, alias_norm.'
}

Table owners.artists {
  id text [pk]
  pseudonym text
  pseudonym_norm text
  owner_id text
  merged_into text
  created_at timestamptz
  origin text
  Note: 'Псевдонимы артистов (ники); любой получатель денег в сплите это псевдоним, у него один владелец. Строк: 2 170.'
}

Table owners.documents {
  id text [pk]
  kind text [note: 'contract, appendix, assumption, label_decision, payment_proof, ...']
  title text
  file_ref text [note: 'pandadoc:<sha256> | путь; личные данные не приводятся']
  owner_id text
  requires_approval boolean
  approved_at timestamptz
  approved_by text
  upload_deadline date
  migration boolean
  created_at timestamptz
  label_id text
  Note: 'Документы (10 видов: договор, приложение, assumption, платёжное подтверждение и др.), статус утверждения, file_ref. Строк: 1 447. Личные данные в колонках: title, file_ref.'
}

Table owners.contracts {
  id text [pk]
  owner_id text
  document_id text
  number text
  created_at timestamptz
  payout_threshold_cents bigint
  Note: 'Договор = документ + владелец + порог выплаты. Строк: 818. Личные данные в колонках: number.'
}

Table owners.contract_artists {
  contract_id text
  artist_id text
  indexes {
    (contract_id, artist_id) [pk]
  }
  Note: 'Какие псевдонимы покрывает договор. Строк: 809.'
}

Table owners.merges {
  id text [pk]
  entity text
  from_id text [note: 'id владельца или псевдонима по entity']
  into_id text [note: 'id владельца или псевдонима по entity']
  reason text
  at timestamptz
  Note: 'Журнал слияний владельцев и псевдонимов (entity = owner | artist). Строк: 2.'
}

// ───────── owners_catalog ─────────
Table owners.tracks {
  id text [pk]
  isrc text [note: 'не уникален сам по себе: уникальна пара (isrc, upc)']
  upc text
  title text
  created_at timestamptz
  "note" text
  Note: 'Каталог треков (ISRC + UPC, уникальна пара); навигация, деньги не читают. Строк: 26 311. Уникально (с org_id): (isrc, upc).'
}

Table owners.artist_tracks {
  artist_id text
  track_id text
  indexes {
    (artist_id, track_id) [pk]
  }
  Note: 'Какой псевдоним привязан к какому треку каталога. Строк: 15 493.'
}

Table owners.track_labels {
  id text [pk]
  isrc text
  label_id text
  valid_from date
  valid_to date
  source text
  "note" text
  created_at timestamptz
  Note: 'История книги (лейбла) ISRC по периодам: files | operator | import; навигация, не деньги (D-172). Строк: 23 635.'
}

Table owners.releases {
  label_id text
  upc text
  release_title text
  version text
  artist_string text
  label_string text [note: 'строка лейбла из экспорта, только показ']
  released_at timestamp without time zone
  track_count integer
  catalog_number text
  territories integer
  stores integer
  created_at timestamptz
  updated_at timestamptz
  indexes {
    (label_id, upc) [pk]
  }
  Note: 'Реестр релизов из экспорта Believe, ключ (label_id, upc); навигация. Строк: 8 235.'
}

// ───────── splits ─────────
Table splits.splits {
  id text [pk]
  isrc text
  valid_from date
  valid_to date
  document_id text
  origin text
  "note" text
  created_at timestamptz
  Note: 'Версия сплита по ISRC на период (valid_to исключительно). Строк: 25 278.'
}

Table splits.split_shares {
  split_id text
  artist_id text
  percent numeric
  document_id text
  is_mc boolean [note: 'D-216']
  indexes {
    (split_id, artist_id) [pk]
  }
  Note: 'Строки сплита: псевдоним, процент, документ, признак MC (D-216). Строк: 44 075.'
}

Table splits.participations {
  id text [pk]
  isrc text
  artist_id text
  percent numeric
  base text
  funded_from text
  from_artist_id text
  valid_from date
  valid_to date
  document_id text
  origin text
  "note" text
  created_at timestamptz
  Note: 'Участия псевдонима на ISRC и дату вне сплита (база, из чьей доли). Строк: 350.'
}

// ───────── sources ─────────
Table public.source_files {
  id uuid [pk]
  source text
  account text [note: 'аккаунт Believe из имени файла']
  reporting_month date
  report_id text
  file_name text
  stored_path text
  sha256 text
  status text
  line_count bigint
  net_total numeric
  gross_total numeric
  uploaded_by text
  created_at timestamptz
  updated_at timestamptz
  label_id text [note: 'книга файла']
  Note: 'Реестр загруженных файлов Believe (аккаунт, месяц, sha256, статус, книга label_id); строки лежат в ClickHouse. Строк: 48.'
}

Table believe.rows {
  file_id UUID
  reporting_month Date
  sales_month Date
  platform String
  country_region String
  label_name String [note: 'строка импринта']
  artist_name String [note: 'строка артиста из отчёта']
  release_title String
  track_title String
  upc String
  isrc String
  release_catalog_number String
  streaming_subscription_type String
  release_type String
  sales_type String
  quantity Int64
  client_payment_currency String
  unit_price Decimal(38,12)
  mechanical_fee Decimal(38,12)
  gross_revenue Decimal(38,12)
  client_share_rate Decimal(18,8)
  net_revenue Decimal(38,12)
  Note: 'ClickHouse (не PostgreSQL): строки отчёта Believe как в файле, ключ ISRC+UPC+месяцы; поверх вьюхи lines, units, breakdown, file_totals, pair_attrs, pair_attrs_latest, pairs. Связи: file_id -> source_files.id (id), label_name -> label_aliases (строка), isrc / upc. Строк: 79 464 937.'
}

// ───────── publishing_v1 ─────────
Table publishing.pub_statements {
  id text [pk]
  source text
  periods text
  file_name text
  stored_path text
  sha256 text
  generated_at timestamptz
  generated_at_source text
  uploaded_at timestamptz
  status text
  line_count integer
  total_payable numeric
  warnings text
  label_id text
  replaced_by text
  Note: 'Выписки B17 v1 (файл, периоды, sha256, статус, replaced_by); деньги по ним больше не считаются (PUBLISHING_SOURCE=v2). Строк: 6. Уникально (с org_id): (sha256).'
}

Table publishing.pub_statement_periods {
  source text
  period text
  statement_id text
  indexes {
    (source, period) [pk]
  }
  Note: 'Какая выписка покрывает какой период источника; PK (source, period). Строк: 7.'
}

Table publishing.pub_lines {
  statement_id text
  line_no integer
  period text
  writer_name text [note: 'имя держателя прав; личные данные']
  writer_norm text
  songwriters text [note: 'имена авторов через запятую (строка); личные данные']
  work_title text
  work_code text
  operation_type text
  retailer text
  country text
  payable_pico bigint
  indexes {
    (statement_id, line_no) [pk]
  }
  Note: 'Строки выписок B17 v1: writer_name (держатель прав), writer_norm, songwriters через запятую, сумма. Строк: 1 162 586. Личные данные в колонках: writer_name, writer_norm, songwriters.'
}

Table publishing.pub_writers {
  writer_norm text [pk]
  display_name text
  owner_id text
  resolution text
  role text
  Note: 'Карта автор -> владелец по нормализованному имени (writer_norm, resolution, role); v1. Строк: 47. Личные данные в колонках: display_name, writer_norm.'
}

Table publishing.pub_terms {
  id text [pk]
  owner_id text
  percent numeric
  valid_from date
  valid_to date
  document_id text
  created_at timestamptz
  operation_type text
  Note: 'Условия автора по типу операции (процент, период, документ) для v1. Строк: 100.'
}

// ───────── pubv2 ─────────
Table pubv2.files {
  id text [pk]
  label_id text
  file_name text
  sha256 text
  source text
  format text
  periods text[] [note: 'массив периодов']
  status text
  replaced_by text
  row_count integer
  payable_pico bigint
  declared_payable_pico bigint
  stored_path text
  uploaded_at timestamptz
  Note: 'Файлы B17 v2 (sha256, периоды, статус, объявленная и посчитанная сумма). Строк: 7. Уникально (с org_id): (sha256).'
}

Table pubv2.songwriters {
  id text [pk]
  name text
  created_at timestamptz
  Note: 'Авторы из отчёта B17 v2 (только имя; без владельца). Строк: 34. Личные данные в колонках: name.'
}

Table pubv2.songwriter_aliases {
  id text [pk]
  songwriter_id text
  name text
  name_norm text
  Note: 'Варианты имени автора (name_norm уникально). Строк: 34. Уникально (с org_id): (name_norm). Личные данные в колонках: name, name_norm.'
}

Table pubv2.songs {
  id text [pk]
  songwriter_id text
  title text
  title_norm text
  Note: 'Песни автора по названию (без ISRC). Строк: 1 169. Уникально (с org_id): (songwriter_id, title_norm).'
}

Table pubv2.song_aliases {
  id text [pk]
  song_id text
  title text
  title_norm text
  Note: 'Варианты названия песни. Строк: 1 169. Уникально (с org_id): (song_id, title_norm).'
}

Table pubv2.accruals {
  id text [pk]
  file_id text
  songwriter_id text
  song_id text
  period text
  gross_pico bigint
  withholding_pico bigint
  payable_pico bigint
  Note: 'Начисления: файл, автор, песня, период, суммы (pico-USD); деньги читают их через facade/pubv2-source.ts. Строк: 4 321.'
}

// ───────── links ─────────
