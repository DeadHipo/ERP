Ref: publishing.pub_writers.writer_norm <> owners.owner_aliases.alias_norm [color: #d62728]  // имя автора -> алиас владельца (D-087)
Ref: publishing.pub_terms.operation_type <> publishing.pub_lines.operation_type [color: #d62728]  // условие автора по типу операции (строка)
Ref: pubv2.songwriter_aliases.name_norm > owners.owner_aliases.alias_norm [color: #d62728]  // рекомендация автор -> владелец по имени (exact_name, same_words)
Ref: pubv2.songwriter_aliases.name_norm > publishing.pub_writers.writer_norm [color: #d62728]  // рекомендация по старой карте v1 (old_map)
Ref: pubv2.songs.title_norm > owners.tracks.title [color: #d62728]  // рекомендация песня -> ISRC по базовому названию
Ref: believe.rows.artist_name > owners.artists.pseudonym_norm [color: #d62728]  // поиск дублей: артист отчёта ~ псевдоним без сплита

