{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api-dist",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "packages/backend/src/main.ts",
        "data"
      ],
      "port": 3001,
      "env": {
        "PORT": "3001"
      }
    },
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:client"
      ],
      "port": 5173
    }
  ]
}