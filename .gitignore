node_modules/
packages/frontend/dist/
*.log
.DS_Store
__pycache__/
*.pyc

# Secrets (the template stays)
.env
.env.*
!.env.example

# Databases and uploaded files of the app (local only, personal data).
# Contents are ignored; only the folder structure is kept through .gitkeep.
/data/**
!/data/**/
!/data/**/.gitkeep

# Reference material with personal data: only the README is tracked
/context_data/*
!/context_data/README.md

# Frontend e2e (Playwright)
packages/frontend/test-results/
packages/frontend/playwright-report/
packages/frontend/e2e/.auth/

packages/frontend/e2e/.seed-keys.json

# local editor and Claude Code settings, worktrees
.claude/
.vscode/
