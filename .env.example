TZ=UTC

# Куда класть данные БД на сервере (bind-mount). В dev используются именованные тома.
# DATA_DIR=./data

# Пароли: только буквы и цифры, например `openssl rand -hex 24`
# (ClickHouse пишет пароль в XML, а в URL Postgres спецсимволы пришлось бы кодировать)

# Postgres (модули owners, splits, settlements, publishing, реестр файлов)
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=erp
DB_USERNAME=erp
DB_PASSWORD=change_me

# ClickHouse (модуль Believe)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DATABASE=believe
CLICKHOUSE_USERNAME=erp
CLICKHOUSE_PASSWORD=change_me

# pgAdmin (только dev, docker-compose.dev.yml). Почта должна быть вида имя@домен.тлд
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me

# Организация и вход (D-170)
# AUTH_MODE: on (по умолчанию) = вход по логину и паролю, cookie erp_session; off только явно (тесты, скрипты,
# локальный стенд): без входа, каждая запись в ERP_DEFAULT_ORG, оператор из заголовка X-Operator
AUTH_MODE=on
# Секрет подписи сессии (HS256), не меньше 32 байт, например `openssl rand -hex 32`; при on без него сервер не стартует
AUTH_SECRET=
# Ключ системного администратора для скриптов и чистого стека (заголовок X-System-Key); пусто = путь выключен
SYSTEM_ADMIN_KEY=
# 1 = cookie __Host-erp_session с атрибутом Secure (только по https)
AUTH_COOKIE_SECURE=
# Неудачные входы в минуту на логин и на IP (D-171): сверх лимита 429 too_many_attempts; 0 = выключено
AUTH_LOGIN_LIMIT=5
AUTH_IP_LIMIT=20
# За обратным прокси: 1 = один прокси (req.ip, X-Forwarded-Host / -Proto в проверке Origin); пусто = без прокси
TRUST_PROXY=
# Дополнительные источники записей (Origin) через запятую, кроме собственного адреса запроса, например https://erp.example.com
APP_ORIGIN=
# Организация при AUTH_MODE=off и по умолчанию для скриптов (их --org / ERP_ORG важнее)
ERP_DEFAULT_ORG=
